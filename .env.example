# Copy to .env. Everything is optional: with no .env the mesh runs offline with scripted models.

# Any Pydantic AI model name. `offline` needs no key and no download.
AGENT_MESH_MODEL=offline
# AGENT_MESH_MODEL=google:gemini-2.5-flash
# GOOGLE_API_KEY=

# Record prompts and answers on spans (redacted). Off by default: they carry personal data.
AGENT_MESH_CAPTURE_MESSAGE_CONTENT=false
